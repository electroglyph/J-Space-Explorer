# ------------------------------------------------------------------
# J-Space Explorer local config (EXAMPLE / template).
#
# Copy this to `jspace.local.env` (which is gitignored) and edit for your
# machine, then launch with:
#
#     ./serve-local.sh
#
# Every value is optional; unset ones fall back to the built-in defaults.
# ------------------------------------------------------------------

# Path to your local safetensors model directory.
JSPACE_MODEL_PATH="/path/to/your/model"

# Where the fitted Jacobian-lens operators are cached (can be a few GB).
# Default: ~/.cache/jspace/lens.pt
#JSPACE_LENS_CACHE="$HOME/.cache/jspace/lens.pt"

# Web server bind address / port.
JSPACE_HOST="127.0.0.1"
JSPACE_PORT="8000"

# Conda env name to activate (default: jspace).
JSPACE_ENV="jspace"

# Load the model at startup instead of on first request (recommended).
JSPACE_EAGER="1"

# --- Runtime knobs (usually leave as-is) ---------------------------
# Silence the deprecated HF transfer path.
HF_HUB_ENABLE_HF_TRANSFER="0"
# Reduce CUDA fragmentation for large models + autograd.
PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"
